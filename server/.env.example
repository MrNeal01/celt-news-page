# LinkedIn developer app "CELT News Widget" → Auth tab
LINKEDIN_CLIENT_ID=777b0w7zghh7wy
LINKEDIN_CLIENT_SECRET=

# Must exactly match one of the "Authorized redirect URLs" on the Auth tab
LINKEDIN_REDIRECT_URI=http://localhost:5000/auth/callback

# MEF University CELT page
LINKEDIN_ORG_ID=80317768

# LinkedIn versions are sunset after ~1 year. Bump this every year (format YYYYMM).
LINKEDIN_API_VERSION=202610

# Sites allowed to call /api/posts from the browser. "*" is fine: the posts are public.
# For a stricter setup use a comma-separated list, e.g. https://sites.google.com
ALLOWED_ORIGIN=*

# Seconds between LinkedIn refreshes (3600 = hourly) and number of posts shown
CACHE_TTL=3600
POSTS_LIMIT=6
